# Database
DB_USER=firetwin
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=firetwin_db

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# CORS - comma-separated list of allowed origins (frontend URLs)
# Example: https://your-frontend.vercel.app,https://your-frontend.netlify.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here